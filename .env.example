# Agentic SOC configuration. Copy to .env and replace every placeholder.
# Generate keys with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Database ----------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Set automatically by docker-compose; for a systemd install point it at your PostgreSQL:
# SOC_DATABASE_URL=postgresql+psycopg://agentic_soc:change-me@127.0.0.1:5432/agentic_soc

# --- API authentication ------------------------------------------------------------------
# Used by the Wazuh integration (same value as <api_key> in ossec-manager.xml).
SOC_INGEST_API_KEY=change-me
# Analyst name -> key. The name is recorded in the audit trail for every human decision.
SOC_ANALYST_API_KEYS={"analyst1": "change-me"}

# --- Execution ---------------------------------------------------------------------------
# dry_run records what playbooks would do. Switch to live only after testing each playbook.
SOC_EXECUTION_MODE=dry_run
SOC_POLICY_FILE=config/policy.yaml

# --- LLM: heuristic | ollama | cloud | hybrid --------------------------------------------
SOC_LLM_PROVIDER=ollama
SOC_OLLAMA_MODEL=llama3.1:8b
# SOC_OLLAMA_URL=http://127.0.0.1:11434
# Cloud (Claude API). The key is read by the Anthropic SDK.
# ANTHROPIC_API_KEY=
SOC_CLOUD_MODEL=claude-opus-5-5
SOC_CLOUD_EFFORT=low
SOC_HYBRID_ESCALATION_CONFIDENCE=0.80

# --- Wazuh -------------------------------------------------------------------------------
SOC_WAZUH_API_URL=https://192.168.50.10:55000
SOC_WAZUH_API_USER=agentic-soc
SOC_WAZUH_API_PASSWORD=change-me
SOC_WAZUH_INDEXER_URL=https://192.168.50.10:9200
SOC_WAZUH_INDEXER_USER=agentic-soc-reader
SOC_WAZUH_INDEXER_PASSWORD=change-me
SOC_WAZUH_MANAGER_IP=192.168.50.10
# Lab CA that signed the Wazuh certificates (keeps TLS verification on).
SOC_TLS_CA_BUNDLE=/opt/agentic-soc/tls/root-ca.pem
# Wazuh agent id of the domain controller (account containment).
SOC_AD_DC_AGENT_ID=001

# --- Threat intelligence -----------------------------------------------------------------
SOC_MISP_URL=https://192.168.50.30
SOC_MISP_API_KEY=change-me
# SOC_VIRUSTOTAL_API_KEY=
SOC_VIRUSTOTAL_REQUESTS_PER_MINUTE=4
SOC_VIRUSTOTAL_DAILY_QUOTA=500

# --- Firewall (BLOCK_IP) -----------------------------------------------------------------
SOC_BLOCK_BACKEND=opnsense
SOC_OPNSENSE_URL=https://192.168.50.1
SOC_OPNSENSE_API_KEY=change-me
SOC_OPNSENSE_API_SECRET=change-me
SOC_OPNSENSE_ALIAS=AGENTIC_SOC_BLOCK

# --- Notifications (optional, e.g. an n8n webhook) ---------------------------------------
# SOC_NOTIFY_WEBHOOK_URL=http://192.168.50.20:5678/webhook/agentic-soc
